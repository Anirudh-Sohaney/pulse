{
  "title": "Pharmaceutical Supply/Demand Dataset (S_D)",
  "description": "Drug-specific pharmaceutical demand and supply information, 2000-2022. Each observation is a drug compound/product + geography + metric + date, with full provenance.",
  "date_range": {"start": "2000-01-01", "end": "2022-12-31"},
  "record": {
    "record_id": "string, deterministic unique id",
    "period_start": "YYYY-MM-DD",
    "period_end": "YYYY-MM-DD",
    "granularity": "day|week|month|quarter|year|event",
    "geography": {
      "country": "string|null",
      "admin1": "string|null",
      "admin2": "string|null",
      "postal_code": "string|null",
      "name": "string|null",
      "code": "string|null",
      "level": "national|country|state|province|region|county|city|postal_code|practice|hospital|unknown"
    },
    "drug": {
      "original_name": "string, source drug name",
      "canonical_name": "string|null",
      "ingredient": "string|null, active ingredient",
      "combination_ingredients": ["string"],
      "brand_name": "string|null",
      "rxnorm_rxcui": "string|null",
      "atc_code": "string|null",
      "ndc": "string|null, 11-digit normalized",
      "manufacturer": "string|null",
      "strength": "string|null",
      "dosage_form": "string|null",
      "route": "string|null",
      "identity_level": "ingredient|clinical_product|commercial_product|unmapped",
      "mapping_status": "mapped|partially_mapped|unmapped",
      "mapping_confidence": "high|medium|low|none"
    },
    "observation": {
      "type": "demand|supply|supply_event",
      "metric": "string, source-native metric",
      "value": "number|null",
      "unit": "string, source-native unit",
      "semantics": "string, meaning of the value",
      "is_quantity": "boolean",
      "is_monetary": "boolean"
    },
    "source": {
      "source_id": "string",
      "source_name": "string",
      "source_url": "string",
      "source_record_id": "string",
      "native_frequency": "string",
      "retrieved_at": "YYYY-MM-DD",
      "published_at": "YYYY-MM-DD|null",
      "event_date": "YYYY-MM-DD|null"
    },
    "quality": {
      "is_imputed": "boolean, always false",
      "is_aggregated": "boolean",
      "is_suppressed": "boolean",
      "notes": "string|null"
    }
  },
  "metrics": [
    "prescription_count", "units_reimbursed", "amount_reimbursed",
    "prescription_items", "quantity_dispensed", "actual_cost",
    "part_d_claims", "thirty_day_fills", "part_d_total_drug_cost",
    "part_d_beneficiaries", "controlled_substance_grams_distributed",
    "grams_per_100k_population", "shortage_active", "recall_event",
    "recalled_quantity", "medicaid_amount_reimbursed",
    "non_medicaid_amount_reimbursed"
  ],
  "rules": [
    "Use source-native metric and unit; never combine units.",
    "Do not treat monetary values as quantity.",
    "Do not spread quarterly/annual values across smaller periods.",
    "No imputation; is_imputed always false.",
    "null = unavailable; 0 = source reported zero.",
    "Do not merge observations across sources or units.",
    "ARCOS grams are supply-flow, not patient consumption.",
    "Recalls and shortages are supply-disruption events, not quantities."
  ]
}