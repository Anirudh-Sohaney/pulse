{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Crosswalk normalized record",
  "type": "object",
  "required": ["source_id", "record_type", "from", "to", "attributes", "provenance"],
  "properties": {
    "source_id": {"type": "string"},
    "record_type": {"type": "string"},
    "from": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {"type": "string"},
        "type": {"type": "string"},
        "name": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "to": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {"type": "string"},
        "type": {"type": "string"},
        "name": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "attributes": {"type": "object"},
    "provenance": {
      "type": "object",
      "required": ["source_url", "retrieved_at"],
      "properties": {
        "source_url": {"type": "string", "format": "uri"},
        "retrieved_at": {"type": "string"},
        "raw_file": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
