{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tariff_policy normalized record",
  "type": "object",
  "required": [
    "record_id", "record_type", "period_start", "period_end", "granularity",
    "reporter", "partner", "product", "measure", "source", "quality"
  ],
  "properties": {
    "record_id": {"type": "string"},
    "record_type": {"type": "string", "enum": ["tariff", "measure"]},
    "period_start": {"type": "string", "format": "date"},
    "period_end": {"type": "string", "format": "date"},
    "granularity": {"type": "string", "enum": ["year", "event", "unknown"]},
    "reporter": {
      "type": "object",
      "required": ["code", "name", "level"],
      "properties": {
        "code": {"type": ["string", "null"]},
        "name": {"type": ["string", "null"]},
        "level": {"type": "string"}
      }
    },
    "partner": {
      "type": "object",
      "required": ["code", "name", "level"],
      "properties": {
        "code": {"type": ["string", "null"]},
        "name": {"type": ["string", "null"]},
        "level": {"type": "string"}
      }
    },
    "product": {
      "type": "object",
      "required": ["code", "revision", "level"],
      "properties": {
        "code": {"type": ["string", "null"]},
        "revision": {"type": ["string", "null"]},
        "level": {"type": "string"},
        "description": {"type": ["string", "null"]}
      }
    },
    "measure": {
      "type": "object",
      "required": ["category", "subtype", "rate", "unit", "medical_flag"],
      "properties": {
        "category": {"type": "string"},
        "subtype": {"type": ["string", "null"]},
        "rate": {"type": ["number", "null"]},
        "unit": {"type": ["string", "null"]},
        "medical_flag": {"type": ["boolean", "null"]},
        "legal_text": {"type": ["string", "null"]}
      }
    },
    "source": {
      "type": "object",
      "required": ["source_id", "source_name", "source_url", "source_record_id", "retrieved_at"],
      "properties": {
        "source_id": {"type": "string"},
        "source_name": {"type": "string"},
        "source_url": {"type": "string", "format": "uri"},
        "source_record_id": {"type": ["string", "null"]},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "release": {"type": ["string", "null"]}
      }
    },
    "quality": {
      "type": "object",
      "required": ["is_imputed", "is_suppressed", "notes"],
      "properties": {
        "is_imputed": {"const": false},
        "is_suppressed": {"type": "boolean"},
        "notes": {"type": ["string", "null"]}
      }
    },
    "source_payload_json": {"type": "string"}
  }
}
