{
  "dataset_name": "Global Economics Sources",
  "focus_window": {
    "start_year": 2012,
    "end_year": 2022,
    "note": "Sources were evaluated and used primarily for this period; data outside it is context only."
  },
  "sources": [
    {
      "source": "World Bank WDI",
      "url": "https://data.worldbank.org/",
      "coverage": "217 countries, 1960–",
      "granularity": "~1,400 annual indicators",
      "access": "Free API",
      "role_in_model": "Country-node baseline"
    },
    {
      "source": "IMF IFS / WEO / BOPS / GFS",
      "url": "https://data.imf.org/",
      "coverage": "~190 countries",
      "granularity": "monthly–annual: FX, rates, CPI, reserves, IP, fiscal",
      "access": "Free",
      "role_in_model": "Macro-distress state"
    },
    {
      "source": "OECD Data Explorer",
      "url": "https://data-explorer.oecd.org/",
      "coverage": "38+ countries",
      "granularity": "monthly MEI, CLI, PPI, industrial production",
      "access": "Free API",
      "role_in_model": "Leading indicators"
    },
    {
      "source": "Penn World Table 11",
      "url": "https://www.rug.nl/ggdc/productivity/pwt/",
      "coverage": "180+ countries, 1950–",
      "granularity": "real GDP, capital stock, TFP",
      "access": "Free",
      "role_in_model": "Long-run structural priors"
    },
    {
      "source": "Maddison Project",
      "url": "https://www.rug.nl/ggdc/historicaldevelopment/maddison/",
      "coverage": "169 countries, year 1–",
      "granularity": "long-run GDP/capita",
      "access": "Free",
      "role_in_model": "Deep history normalization"
    },
    {
      "source": "BIS Statistics",
      "url": "https://data.bis.org/",
      "coverage": "60+ countries",
      "granularity": "credit, debt service, FX, property",
      "access": "Free",
      "role_in_model": "Financial-crisis channel"
    },
    {
      "source": "UNCTADstat",
      "url": "https://unctadstat.unctad.org/",
      "coverage": "200+ countries",
      "granularity": "FDI, commodity prices, maritime, GVC",
      "access": "Free",
      "role_in_model": "FDI + maritime"
    },
    {
      "source": "V-Dem",
      "url": "https://v-dem.net/data/",
      "coverage": "202 countries, 1789–",
      "granularity": "500+ political/institutional indicators",
      "access": "Free",
      "role_in_model": "Institutional/regulatory capacity"
    },
    {
      "source": "World Uncertainty Index",
      "url": "https://worlduncertaintyindex.com/",
      "coverage": "143 countries, quarterly",
      "granularity": "text-derived uncertainty",
      "access": "Free",
      "role_in_model": "Ready-made news-derived benchmark"
    },
    {
      "source": "EPU / TPU / GPR indices",
      "url": "https://www.policyuncertainty.com/",
      "coverage": "20+ countries, monthly/daily",
      "granularity": "policy + trade + geopolitical risk",
      "access": "Free",
      "role_in_model": "Baseline your LLM index must beat"
    },
    {
      "source": "World Bank Enterprise Surveys",
      "url": "https://www.enterprisesurveys.org/",
      "coverage": "~150 countries",
      "granularity": "firm-level constraints incl. pharma mfg",
      "access": "Free",
      "role_in_model": "Firm-node priors"
    }
  ]
}
