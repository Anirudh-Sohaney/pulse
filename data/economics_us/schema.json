{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "economics_us normalized observation",
  "type": "object",
  "required": ["record_id", "period_start", "period_end", "granularity", "geography", "observation", "source", "quality"],
  "properties": {
    "record_id": {"type": "string"},
    "period_start": {"type": "string", "format": "date"},
    "period_end": {"type": "string", "format": "date"},
    "granularity": {"type": "string", "enum": ["month", "quarter", "year", "fiscal_year"]},
    "geography": {
      "type": "object",
      "required": ["country", "name", "code", "level"],
      "properties": {
        "country": {"type": ["string", "null"]},
        "name": {"type": ["string", "null"]},
        "code": {"type": ["string", "null"]},
        "level": {"type": "string"}
      }
    },
    "observation": {
      "type": "object",
      "required": ["metric", "value", "unit", "semantics"],
      "properties": {
        "metric": {"type": "string"},
        "value": {"type": "number"},
        "unit": {"type": "string"},
        "semantics": {"type": "string"}
      }
    },
    "source": {
      "type": "object",
      "required": ["source_id", "source_name", "source_url", "retrieved_at"],
      "properties": {
        "source_id": {"type": "string"},
        "source_name": {"type": "string"},
        "source_url": {"type": "string", "format": "uri"},
        "source_record_id": {"type": ["string", "null"]},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "vintage_date": {"type": ["string", "null"]}
      }
    },
    "quality": {
      "type": "object",
      "required": ["is_imputed", "is_suppressed"],
      "properties": {
        "is_imputed": {"const": false},
        "is_suppressed": {"type": "boolean"},
        "notes": {"type": ["string", "null"]}
      }
    }
  }
}
