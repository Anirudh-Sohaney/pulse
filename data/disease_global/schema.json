{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Global Disease Epidemiology Normalized Observation",
  "type": "object",
  "required": ["source_id", "dataset_id", "period", "geography", "metric", "value", "unit", "dimensions", "provenance"],
  "properties": {
    "source_id": {"type": "string"},
    "dataset_id": {"type": "string"},
    "period": {
      "type": "object",
      "required": ["year"],
      "properties": {
        "year": {"type": "integer"},
        "week": {"type": ["integer", "null"]},
        "epiweek": {"type": ["integer", "null"]}
      },
      "additionalProperties": false
    },
    "geography": {
      "type": "object",
      "required": ["level", "id", "name"],
      "properties": {
        "level": {"type": "string"},
        "id": {"type": "string"},
        "name": {"type": "string"}
      },
      "additionalProperties": false
    },
    "metric": {"type": "string"},
    "value": {"type": "number"},
    "unit": {"type": "string"},
    "dimensions": {"type": "object"},
    "provenance": {
      "type": "object",
      "required": ["source_url", "retrieved_at", "raw_file"],
      "properties": {
        "source_url": {"type": "string", "format": "uri"},
        "retrieved_at": {"type": "string"},
        "raw_file": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
